.attachment-wood-frame {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  filter: drop-shadow(0 17rpx 19rpx rgba(54,29,15,.34));
}
.attachment-wood-frame::before {
  content: '';
  position: absolute;
  z-index: 5;
  top: 9rpx;
  right: 9rpx;
  bottom: 9rpx;
  left: 9rpx;
  border: 3rpx solid rgba(224,177,112,.52);
  box-shadow: inset 0 0 9rpx rgba(39,20,10,.34), 0 0 0 2rpx rgba(55,29,14,.24);
}
.attachment-wood-frame::after {
  content: '';
  position: absolute;
  z-index: 3;
  top: 34rpx;
  right: 34rpx;
  bottom: 34rpx;
  left: 34rpx;
  border: 7rpx solid #e9d9ba;
  box-shadow: 0 0 0 3rpx #58321c, inset 0 0 16rpx rgba(55,30,15,.2);
}
.wood-frame-rail {
  position: absolute;
  z-index: 4;
  display: block;
}
.wood-frame-rail-top,
.wood-frame-rail-bottom {
  left: 0;
  width: 100%;
  height: 38rpx;
  background:
    radial-gradient(ellipse at 24% 55%, rgba(45,22,10,.38) 0 3rpx, transparent 4rpx),
    radial-gradient(ellipse at 71% 38%, rgba(239,196,131,.16) 0 5rpx, transparent 6rpx),
    repeating-linear-gradient(5deg, rgba(236,189,121,.1) 0 1rpx, transparent 1rpx 14rpx),
    linear-gradient(180deg, #74401f 0%, #a56a38 20%, #5d3018 48%, #8b5129 70%, #43210f 100%);
}
.wood-frame-rail-left,
.wood-frame-rail-right {
  top: 0;
  width: 38rpx;
  height: 100%;
  background:
    radial-gradient(ellipse at 45% 27%, rgba(45,22,10,.36) 0 3rpx, transparent 4rpx),
    radial-gradient(ellipse at 62% 76%, rgba(239,196,131,.15) 0 5rpx, transparent 6rpx),
    repeating-linear-gradient(85deg, rgba(236,189,121,.1) 0 1rpx, transparent 1rpx 14rpx),
    linear-gradient(90deg, #6d391c 0%, #9d6233 20%, #542914 48%, #814824 70%, #3c1d0d 100%);
}
.wood-frame-rail-top { top: 0; clip-path: polygon(0 0, 100% 0, calc(100% - 38rpx) 100%, 38rpx 100%); }
.wood-frame-rail-right { right: 0; clip-path: polygon(0 38rpx, 100% 0, 100% 100%, 0 calc(100% - 38rpx)); }
.wood-frame-rail-bottom { bottom: 0; clip-path: polygon(38rpx 0, calc(100% - 38rpx) 0, 100% 100%, 0 100%); }
.wood-frame-rail-left { left: 0; clip-path: polygon(0 0, 100% 38rpx, 100% calc(100% - 38rpx), 0 100%); }
