.home-page {
  min-height: 100vh;
  padding: calc(44rpx + env(safe-area-inset-top)) 40rpx calc(52rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #fbf8f2;
  color: #11110f;
}

.home-header { padding: 8rpx 8rpx 0; }
.home-kicker { font-size: 31rpx; font-weight: 650; letter-spacing: -1rpx; }
.home-title { margin-top: 54rpx; font-size: 51rpx; font-weight: 700; line-height: 1.2; letter-spacing: -3rpx; }

.puzzle-cluster {
  position: relative;
  height: 770rpx;
  margin-top: 18rpx;
}

.puzzle-piece {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  overflow: visible;
  transition: transform 160ms ease, opacity 160ms ease;
}

.piece-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.piece-pending .piece-art { opacity: 0.16; }
.piece-done .piece-art { opacity: 1; }
.piece-pressed { transform: scale(0.95) !important; }

.piece-0 { z-index: 5; top: 0; left: -40rpx; width: 282rpx; height: 282rpx; transform: rotate(-8deg); }
.piece-1 { z-index: 4; top: -8rpx; right: -40rpx; width: 326rpx; height: 326rpx; transform: rotate(8deg); }
.piece-2 { z-index: 3; top: 222rpx; left: 24rpx; width: 326rpx; height: 326rpx; transform: rotate(5deg); }
.piece-3 { z-index: 2; top: 238rpx; right: -52rpx; width: 340rpx; height: 340rpx; transform: rotate(-12deg); }
.piece-4 { z-index: 6; top: 480rpx; left: 184rpx; width: 330rpx; height: 330rpx; transform: rotate(4deg); }

.piece-copy {
  position: absolute;
  z-index: 2;
  left: 50%;
  bottom: 46rpx;
  width: 210rpx;
  display: flex;
  transform: translateX(-50%);
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.piece-name { font-size: 24rpx; font-weight: 650; line-height: 1.3; }
.piece-keyword { max-width: 210rpx; margin-top: 5rpx; overflow: hidden; font-size: 20rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.piece-status { margin-top: 4rpx; color: #8b887f; font-size: 19rpx; }
.piece-1 .piece-copy { bottom: 55rpx; }
.piece-2 .piece-copy { bottom: 58rpx; }
.piece-3 .piece-copy { bottom: 65rpx; }
.piece-4 .piece-copy { bottom: 58rpx; }

.puzzle-progress { margin-top: 28rpx; padding: 0 8rpx; color: #666157; font-size: 27rpx; }
.progress-number { color: #f47716; font-size: 33rpx; font-weight: 700; }

.explore-section { margin-top: 62rpx; }
.explore-title { padding: 0 8rpx; font-size: 30rpx; font-weight: 650; }
.recommend-card {
  width: 100%;
  min-height: 188rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  padding: 34rpx 28rpx 34rpx 38rpx;
  border: 1rpx solid rgba(20, 20, 18, 0.06);
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 20rpx 48rpx rgba(71, 58, 35, 0.07);
  text-align: left;
}
.recommend-pressed { transform: translateY(2rpx); background: #f7f4ee; }
.recommend-copy { min-width: 0; flex: 1; }
.recommend-question { max-width: 470rpx; font-size: 31rpx; font-weight: 650; line-height: 1.45; }
.recommend-duration { margin-top: 16rpx; color: #8d8980; font-size: 23rpx; }
.recommend-arrow { width: 78rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #0d0d0c; color: #fff; font-size: 39rpx; }
