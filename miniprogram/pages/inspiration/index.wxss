.inspiration-page { display: flex; min-height: 100vh; flex-direction: column; }
.inspiration-title { margin-top: 18rpx; font-size: 54rpx; line-height: 1.42; }
.choice-list { margin-top: 62rpx; display: flex; flex-direction: column; gap: 18rpx; }
.choice {
  min-height: 114rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 28rpx 18rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 36rpx;
  background: #fff;
  font-size: 31rpx;
  text-align: left;
}
.choice-selected { border-color: rgba(112,149,212,.4); background: #f2f5fa; }
.choice-mist { width: 80rpx; height: 80rpx; flex: 0 0 80rpx; }
.inspiration-spacer { flex: 1; min-height: 80rpx; }
.inspiration-note { margin-top: 20rpx; text-align: center; }
.card-face {
  min-height: 560rpx;
  margin-top: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 0 54rpx;
  overflow: hidden;
  border-radius: 48rpx;
  background: #f7f4fa;
  text-align: center;
}
.tarot-art { width: 100%; height: 520rpx; }
.card-content { padding: 0 44rpx; }
.card-symbol { margin-top: 16rpx; color: #8a78a5; font-size: 22rpx; letter-spacing: 4rpx; text-transform: uppercase; }
.card-title { margin-top: 22rpx; font-size: 36rpx; }
.card-line { margin-top: 34rpx; font-size: 38rpx; line-height: 1.65; }
.reflection-label { margin-top: 54rpx; color: var(--muted); font-size: 24rpx; }
.reflection-copy { margin-top: 14rpx; color: #565450; font-size: 29rpx; line-height: 1.75; }
.reflection-question { margin-top: 14rpx; font-size: 35rpx; line-height: 1.65; }
.action-card { margin-top: 34rpx; padding: 28rpx 30rpx; border-radius: 30rpx; background: #f5f0f7; }
.action-label { margin-top: 0; }
.note-input { width: 100%; min-height: 220rpx; margin: 38rpx 0 28rpx; padding: 28rpx; border-radius: 30rpx; background: #f1f1ee; font-size: 28rpx; }
.redraw { margin-top: 26rpx; color: var(--muted); font-size: 25rpx; }
