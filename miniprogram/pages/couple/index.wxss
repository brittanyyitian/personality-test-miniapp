.couple-page {
  min-height: 100vh;
  overflow: hidden;
  padding: calc(54rpx + env(safe-area-inset-top)) 38rpx calc(64rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 9% 5%, rgba(249,226,128,.24), transparent 25%),
    radial-gradient(circle at 94% 21%, rgba(201,220,245,.28), transparent 28%),
    #fff7e4;
  color: #171512;
}

.couple-eyebrow { color: #e34831; font-size: 21rpx; font-weight: 820; letter-spacing: 3rpx; }
.couple-title { max-width: 650rpx; margin-top: 22rpx; font-size: 58rpx; font-weight: 900; line-height: 1.13; letter-spacing: -4rpx; }
.couple-intro { max-width: 640rpx; margin-top: 28rpx; color: #4f493f; font-size: 27rpx; line-height: 1.72; }

.couple-hero { position: relative; height: 286rpx; margin-top: 34rpx; display: flex; align-items: center; justify-content: center; }
.couple-person { position: relative; width: 252rpx; height: 252rpx; }
.couple-person image { width: 100%; height: 100%; display: block; }
.couple-person text { position: absolute; right: 22rpx; bottom: 12rpx; min-width: 52rpx; padding: 7rpx 12rpx; border: 2rpx solid #211f1a; border-radius: 28rpx; background: #fff9e9; font-size: 20rpx; font-weight: 850; text-align: center; }
.couple-person-me { z-index: 2; margin-right: -44rpx; transform: rotate(-5deg); }
.couple-person-partner { z-index: 1; margin-left: -44rpx; opacity: .19; filter: grayscale(.65); transform: rotate(7deg); }
.couple-person-arrived { opacity: 1; filter: none; }
.couple-join { z-index: 4; width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(31,28,22,.16); border-radius: 50%; background: #fffaf0; font-size: 31rpx; font-weight: 900; }

.couple-belief { margin-top: 10rpx; padding: 26rpx 28rpx; border: 1rpx solid rgba(74,58,30,.11); border-radius: 28rpx; background: rgba(255,255,255,.78); }
.couple-belief view { font-size: 28rpx; font-weight: 850; }
.couple-belief text { display: block; margin-top: 8rpx; color: #6f6659; font-size: 23rpx; line-height: 1.6; }

.couple-requirements { margin-top: 28rpx; }
.couple-requirements-title { margin-bottom: 18rpx; color: #3b362e; font-size: 25rpx; font-weight: 800; }
.couple-requirement { width: 100%; min-height: 142rpx; margin-top: 14rpx; padding: 18rpx 20rpx; display: grid; grid-template-columns: 94rpx 1fr auto; gap: 16rpx; align-items: center; border: 1rpx solid rgba(63,52,31,.11); border-radius: 28rpx; background: rgba(255,255,255,.84); text-align: left; }
.couple-requirement image { width: 94rpx; height: 94rpx; }
.couple-requirement-copy { min-width: 0; }
.couple-requirement-copy text { display: block; font-size: 27rpx; font-weight: 850; }
.couple-requirement-hint { display: block; margin-top: 5rpx; color: #81786d; font-size: 20rpx; }
.couple-requirement-state { color: #e34831; font-size: 20rpx; font-weight: 760; white-space: nowrap; }
.couple-requirement-done { background: rgba(239,247,229,.86); }
.couple-requirement-done .couple-requirement-state { color: #39795c; }

.couple-ready-card { margin-top: 28rpx; padding: 24rpx 26rpx; display: flex; align-items: center; gap: 20rpx; border: 1rpx solid rgba(58,91,65,.12); border-radius: 28rpx; background: #eef6e5; }
.couple-ready-mark { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #3e8a65; color: #fff; font-size: 28rpx; font-weight: 900; }
.couple-ready-title { font-size: 26rpx; font-weight: 850; }
.couple-ready-copy { margin-top: 4rpx; color: #64705f; font-size: 20rpx; }

.couple-primary { width: 100%; min-height: 102rpx; margin-top: 22rpx; border-radius: 54rpx; background: #11100e; color: #fffaf0; font-size: 29rpx; font-weight: 760; }
.couple-action-note { margin-top: 13rpx; color: #8d8375; font-size: 20rpx; text-align: center; }
.couple-manual-toggle { width: 100%; margin-top: 22rpx; padding: 15rpx; color: #6f6559; font-size: 22rpx; text-decoration: underline; text-underline-offset: 6rpx; }
.couple-code-panel { margin-top: 12rpx; padding: 24rpx; border: 1rpx dashed rgba(64,53,35,.18); border-radius: 28rpx; background: rgba(255,255,255,.62); }
.couple-code-label { font-size: 23rpx; font-weight: 780; }
.code-input { width: 100%; min-height: 170rpx; margin-top: 14rpx; padding: 20rpx; border-radius: 20rpx; background: #f3ede2; color: #555047; font-family: monospace; font-size: 19rpx; line-height: 1.55; }
.couple-code-submit { width: 100%; min-height: 84rpx; margin-top: 16rpx; border-radius: 44rpx; background: #e34831; color: #fff; font-size: 24rpx; font-weight: 760; }
.couple-code-submit[disabled] { background: #d8d1c7; color: #f4efe8; }
.couple-copy-code { width: 100%; margin-top: 8rpx; padding: 14rpx; color: #766c5f; font-size: 21rpx; }
.couple-privacy { margin: 20rpx auto 0; max-width: 560rpx; color: #918779; font-size: 20rpx; line-height: 1.55; text-align: center; }

.couple-report-hero { margin-top: 18rpx; }
.report-cards { margin-top: 14rpx; display: grid; gap: 16rpx; }
.report-card { position: relative; padding: 28rpx 28rpx 30rpx 92rpx; border: 1rpx solid rgba(68,55,31,.12); border-radius: 28rpx; background: rgba(255,255,255,.84); }
.report-card-0 { background: #f7e7b8; }
.report-card-1 { background: #e7efda; }
.report-card-2 { background: #eee4f8; }
.report-card-3 { background: #e4ecfb; }
.report-index { position: absolute; top: 28rpx; left: 26rpx; width: 46rpx; height: 46rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid currentColor; border-radius: 50%; color: #d94831; font-size: 15rpx; font-weight: 850; }
.report-title { font-size: 29rpx; font-weight: 880; }
.report-body { margin-top: 12rpx; color: #514b42; font-size: 24rpx; line-height: 1.72; }
.couple-action { margin-top: 20rpx; padding: 28rpx; border-radius: 28rpx; background: #e34831; color: #fff9ee; }
.couple-action text { font-size: 18rpx; font-weight: 760; letter-spacing: 1rpx; opacity: .78; }
.couple-action view { margin-top: 10rpx; font-size: 25rpx; font-weight: 720; line-height: 1.65; }
.couple-report-boundary { margin-top: 18rpx; color: #857b6e; font-size: 20rpx; line-height: 1.55; text-align: center; }
.couple-reset { width: 100%; margin-top: 12rpx; padding: 18rpx; color: #766c5f; font-size: 22rpx; }
